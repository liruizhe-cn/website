---
import "@fontsource-variable/eb-garamond";
import "@fontsource-variable/eb-garamond/wght-italic.css";
import "@fontsource-variable/inter";
import "../styles/fonts-ja.css";
import {
  getLocaleFromPath,
  getResumeData,
  siteContent,
} from "../i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const resumeData = getResumeData(locale);
const content = siteContent[locale].resume;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{resumeData.name} — {content.title}</title>
  </head>
  <body>
    <main>
      <section class="page page-one">
        <header>
          <div>
            <p class="eyebrow">{content.title}</p>
            <h1>{resumeData.name}</h1>
            <p class="subtitle">{resumeData.title}</p>
          </div>
          <div class="contact">
            <a href={`mailto:${resumeData.contact.email}`}>
              {resumeData.contact.email}
            </a>
            <a href={resumeData.contact.githubUrl}>
              {resumeData.contact.githubLabel}
            </a>
            <span>{resumeData.contact.wechat}</span>
          </div>
        </header>

        <section>
          <h2>{content.sections.profile}</h2>
          {resumeData.profile.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section>
          <h2>{content.sections.education}</h2>
          {
            resumeData.education.map((entry) => (
              <article class="dated-entry">
                <div>
                  <h3>{entry.institution}</h3>
                  <p>
                    {"detail" in entry && entry.detail
                      ? `${entry.detail}, `
                      : ""}
                    <em>{entry.status}</em>
                  </p>
                </div>
                <time>{entry.date}</time>
              </article>
            ))
          }
        </section>

        <section>
          <h2>{content.sections.awards}</h2>
          <div class="award-list">
            {
              resumeData.awards.map((award) => (
                <article class="dated-entry award">
                  <div>
                    <h3>{award.title}</h3>
                    {"level" in award && award.level && (
                      <p class="meta">{award.level}</p>
                    )}
                    {"work" in award && award.work && (
                      <p>
                        {content.work}: <a href={award.work.url}>{award.work.title}</a>
                      </p>
                    )}
                  </div>
                  <time>{award.date}</time>
                </article>
              ))
            }
          </div>
        </section>

        <section>
          <h2>{content.sections.experience}</h2>
          {
            resumeData.experience.map((entry) => (
              <article class="dated-entry">
                <h3>
                  {entry.title}
                  {"role" in entry && entry.role ? ` — ${entry.role}` : ""}
                </h3>
                <time>{entry.date}</time>
              </article>
            ))
          }
        </section>
      </section>

      <section class="page page-two">
        <header class="compact-header">
          <div>
            <p class="eyebrow">{content.selectedWork}</p>
            <h1>{content.selectedWorkTitle}</h1>
          </div>
          <p class="page-name">{resumeData.name}</p>
        </header>

        <section>
          <h2>{content.sections.projects}</h2>
          <div class="project-list">
            {
              resumeData.projects.map((project) => (
                <article class="project">
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section>
          <h2>{content.sections.skills}</h2>
          <div class="skills">
            {
              resumeData.skills.map((skill) => (
                <article>
                  <h3>{skill.category}</h3>
                  <p>{skill.items.join(" · ")}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section class="closing">
          <h2>{content.sections.contact}</h2>
          <div class="contact-grid">
            <div>
              <span>{content.labels.email}</span>
              <a href={`mailto:${resumeData.contact.email}`}>
                {resumeData.contact.email}
              </a>
            </div>
            <div>
              <span>{content.labels.github}</span>
              <a href={resumeData.contact.githubUrl}>
                {resumeData.contact.githubLabel}
              </a>
            </div>
            <div>
              <span>{content.labels.wechat}</span>
              <strong>{resumeData.contact.wechat}</strong>
            </div>
          </div>
        </section>
      </section>
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  :root {
    font-family: "EB Garamond Variable", Garamond, serif;
    color: #171717;
    background: #e8e6e1;
  }

  html[lang="ja"] {
    font-family: "EB Garamond Variable", "Shippori Mincho", "Yu Mincho",
      "Hiragino Mincho ProN", serif;
    font-feature-settings:
      "palt" 1,
      "pkna" 1;
    line-break: strict;
    overflow-wrap: anywhere;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    background: #e8e6e1;
  }

  body {
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .page {
    width: 210mm;
    height: 297mm;
    padding: 18mm 19mm 16mm;
    background:
      linear-gradient(135deg, rgba(54, 89, 72, 0.08), transparent 36%),
      #fbfaf7;
    overflow: hidden;
    page-break-after: always;
  }

  .page:last-child {
    page-break-after: auto;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12mm;
    margin-bottom: 9mm;
    padding-bottom: 5mm;
    border-bottom: 0.35mm solid #315c4a;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1mm;
    font-size: 30pt;
    line-height: 0.95;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .eyebrow,
  .subtitle,
  .contact,
  time,
  .meta,
  .contact-grid span,
  .page-name {
    font-family: "Inter Variable", sans-serif;
  }

  html[lang="ja"] .eyebrow,
  html[lang="ja"] .subtitle,
  html[lang="ja"] .contact,
  html[lang="ja"] time,
  html[lang="ja"] .meta,
  html[lang="ja"] .contact-grid span,
  html[lang="ja"] .page-name,
  html[lang="ja"] .skills p {
    font-family: "Inter Variable", "Noto Sans JP", "Hiragino Sans",
      "Yu Gothic", sans-serif;
  }

  html[lang="ja"] h1 {
    letter-spacing: 0.02em;
    line-height: 1.16;
  }

  html[lang="ja"] h2,
  html[lang="ja"] h3 {
    letter-spacing: 0.025em;
  }

  html[lang="ja"] p {
    line-height: 1.52;
  }

  .eyebrow {
    margin-bottom: 2.5mm;
    color: #315c4a;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .subtitle {
    margin-bottom: 0;
    color: #5d625f;
    font-size: 8.5pt;
  }

  .contact {
    display: grid;
    gap: 1.2mm;
    text-align: right;
    font-size: 7.6pt;
  }

  a {
    color: inherit;
    text-decoration-color: #809a8e;
    text-underline-offset: 0.12em;
  }

  section section {
    margin-bottom: 6.5mm;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 3mm;
    margin-bottom: 3mm;
    color: #315c4a;
    font-size: 12.5pt;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  h2::after {
    content: "";
    flex: 1;
    height: 0.22mm;
    background: #b6c4bd;
  }

  h3 {
    margin-bottom: 0.6mm;
    font-size: 9.4pt;
    line-height: 1.15;
    font-weight: 650;
  }

  p {
    margin-bottom: 2.2mm;
    font-size: 9pt;
    line-height: 1.36;
  }

  .dated-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6mm;
    align-items: baseline;
    margin-bottom: 2.7mm;
    break-inside: avoid;
  }

  .dated-entry p {
    margin-bottom: 0;
  }

  time {
    color: #686d6a;
    font-size: 7.4pt;
    white-space: nowrap;
  }

  .award-list {
    display: grid;
    gap: 0.5mm;
  }

  .award {
    margin-bottom: 1.5mm;
  }

  .award h3 {
    font-size: 8.7pt;
  }

  .award p {
    font-size: 8pt;
    line-height: 1.25;
  }

  .meta {
    color: #59605c;
  }

  .compact-header {
    align-items: center;
  }

  .compact-header h1 {
    font-size: 24pt;
  }

  .page-name {
    color: #59605c;
    font-size: 8pt;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-list {
    display: grid;
    gap: 4mm;
  }

  .project {
    padding: 4mm 4.5mm;
    border: 0.25mm solid #cad3ce;
    border-radius: 2mm;
    background: rgba(255, 255, 255, 0.58);
    break-inside: avoid;
  }

  .project h3 {
    color: #294f40;
    font-size: 12pt;
  }

  .project p {
    margin-bottom: 0;
    font-size: 9.3pt;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4mm;
  }

  .skills article {
    padding-top: 2.5mm;
    border-top: 0.45mm solid #6d8b7e;
  }

  .skills p {
    margin-bottom: 0;
    color: #454a47;
    font-family: "Inter Variable", sans-serif;
    font-size: 8pt;
    line-height: 1.5;
  }

  .closing {
    margin-top: 10mm;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4mm;
  }

  .contact-grid div {
    display: grid;
    gap: 1.2mm;
  }

  .contact-grid span {
    color: #69706c;
    font-size: 7pt;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-grid a,
  .contact-grid strong {
    font-size: 9pt;
    font-weight: 600;
  }

  @media screen {
    main {
      display: grid;
      gap: 12mm;
      justify-content: center;
      padding: 12mm 0;
    }

    .page {
      box-shadow: 0 6mm 18mm rgba(23, 30, 27, 0.18);
    }
  }

  @media print {
    html,
    body {
      background: transparent;
    }
  }
</style>
