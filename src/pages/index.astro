---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import SectionWrapper from "../components/home/SectionWrapper.astro";
import AboutMeContent from "../components/home/content/AboutMeContent.astro";
import FocusStrengthsContent from "../components/home/content/FocusStrengthsContent.astro";
import FeaturedWorksContent from "../components/home/content/FeaturedWorksContent.astro";
import HighlightsUpdatesContent from "../components/home/content/HighlightsUpdatesContent.astro";
import ConnectContent from "../components/home/content/ConnectContent.astro";
import { getLocaleFromPath, siteContent } from "../i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const content = siteContent[locale];
---

<Layout title={content.home.title} description={content.meta.description}>
  <main class="homepage-content">
    <Hero />

    <SectionWrapper>
      <AboutMeContent />
    </SectionWrapper>

    <SectionWrapper>
      <FocusStrengthsContent />
    </SectionWrapper>

    <SectionWrapper>
      <ConnectContent />
    </SectionWrapper>
  </main>
</Layout>

<style>
  .homepage-content {
    display: flex;
    flex-direction: column;
  }
  main {
    position: relative;
    width: 100%;
  }
</style>
