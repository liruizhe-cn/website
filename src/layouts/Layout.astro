---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/eb-garamond";
import "@fontsource-variable/eb-garamond/wght-italic.css";
import "@fontsource-variable/inter";
import "../styles/fonts-ja.css";
import DynamicBackground from "../components/DynamicBackground.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import Footer from "../components/Footer.astro";
import {
  getLocaleFromPath,
  localizedPath,
  siteContent,
  stripLocale,
} from "../i18n";

interface Props {
  title?: string;
  description?: string;
  showIndicatorOverride?: boolean;
}
const { title, description, showIndicatorOverride } = Astro.props;

const currentPath = Astro.url.pathname;
const locale = getLocaleFromPath(currentPath);
const content = siteContent[locale];
const pageTitle = `${title || content.meta.defaultTitle} | CalvinLee`;
const pageDescription = description || content.meta.description;
const canonicalPath = localizedPath(locale, currentPath);
const englishPath = localizedPath("en", currentPath);
const japanesePath = localizedPath("ja", currentPath);
const canonicalUrl = new URL(canonicalPath, Astro.site);
const englishUrl = new URL(englishPath, Astro.site);
const japaneseUrl = new URL(japanesePath, Astro.site);
const shouldShowBasedOnPath = stripLocale(currentPath) === "/";
const showScrollIndicator =
  showIndicatorOverride !== undefined
    ? showIndicatorOverride
    : shouldShowBasedOnPath;
---

<!doctype html>
<html
  lang={locale}
  data-locale={locale}
  data-page={shouldShowBasedOnPath ? "home" : "subpage"}
  transition:animate="none"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="ja" href={japaneseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <title>{pageTitle}</title>
    <ClientRouter fallback="swap" />
    <script is:inline define:vars={{ locale, japanesePath }}>
      const languageStorageKey = "calvin-site-language";
      let savedLanguage = "";
      try {
        savedLanguage = window.localStorage.getItem(languageStorageKey) || "";
      } catch {}

      if (locale === "en") {
        const prefersJapanese = (window.navigator.languages || [
          window.navigator.language,
        ]).some((language) => language?.toLowerCase().startsWith("ja"));
        if (savedLanguage === "ja" || (!savedLanguage && prefersJapanese)) {
          window.location.replace(
            `${japanesePath}${window.location.search}${window.location.hash}`
          );
        }
      }
    </script>
    <script is:inline>
      const isDarkMode =
        window.matchMedia &&
        window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (isDarkMode) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      if (!window.__calvinPalette) {
        const palettes = [
          "verdigris",
          "lapis",
          "moss",
          "slate",
          "apricot",
          "iris",
          "garnet",
          "glacier",
        ];
        let current = "";
        let previous = "";
        try {
          current =
            window.sessionStorage.getItem("calvin-background-palette") || "";
          previous =
            window.localStorage.getItem("calvin-previous-palette") || "";
        } catch {}

        if (palettes.includes(current)) {
          window.__calvinPalette = current;
        } else {
          const choices = palettes.filter((palette) => palette !== previous);
          const randomValue = window.crypto?.getRandomValues
            ? window.crypto.getRandomValues(new Uint32Array(1))[0]
            : Math.floor(Math.random() * 2 ** 32);
          window.__calvinPalette = choices[randomValue % choices.length];
        }

        try {
          window.sessionStorage.setItem(
            "calvin-background-palette",
            window.__calvinPalette
          );
          window.localStorage.setItem(
            "calvin-previous-palette",
            window.__calvinPalette
          );
        } catch {}
      }

      document.documentElement.dataset.palette = window.__calvinPalette;
    </script>
    <style>
      :root {
        /* Light Theme (Default) */
        --bg-color: var(--theme-surface, #f5faf8);
        --text-color: var(--theme-ink, #172421);
        --text-muted: var(--theme-muted, #354440);
        --link-color: var(--text-color);
        --link-hover-color: var(--theme-ink-strong, #0d1715);
        --link-visited-color: var(--link-hover-color);
        --footer-bg: color-mix(
          in oklch,
          var(--theme-surface) 82%,
          var(--theme-primary)
        );
        --footer-text: var(--theme-muted);
        --footer-heading: var(--theme-ink-strong);
        --footer-link: var(--theme-muted);
        --footer-link-hover: var(--theme-ink-strong);
        --footer-copyright: color-mix(
          in oklch,
          var(--theme-muted) 72%,
          var(--theme-surface)
        );

        --button-hover-bg: color-mix(
          in oklch,
          var(--theme-primary) 12%,
          transparent
        );
        --button-hover-text: var(--theme-ink-strong);
        --button-border-color: color-mix(
          in oklch,
          var(--theme-ink) 46%,
          transparent
        );
        --button-border-hover-color: color-mix(
          in oklch,
          var(--theme-ink-strong) 78%,
          transparent
        );

        --card-border-color: var(--button-border-color);

        --timeline-marker-border-color: var(--theme-ink);
        --timeline-marker-bg-color: var(--theme-ink);
        --timeline-line-color: color-mix(
          in oklch,
          var(--theme-ink) 22%,
          transparent
        );

        --font-family-serif: "EB Garamond Variable", Garamond,
          "Times New Roman", serif;
        --font-family-sans: "Inter Variable", -apple-system, BlinkMacSystemFont,
          "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji",
          "Segoe UI Emoji", "Segoe UI Symbol";
        --font-family-japanese-serif: "Shippori Mincho", "Yu Mincho",
          "Hiragino Mincho ProN", serif;
        --font-family-japanese-sans: "Noto Sans JP", "Hiragino Sans",
          "Yu Gothic", sans-serif;
      }

      html.dark {
        --bg-color: var(--theme-surface, #111918);
        --text-color: var(--theme-ink, #ecf3f1);
        --text-muted: var(--theme-muted, #c3cecb);
        --link-color: var(--text-color);
        --link-hover-color: var(--theme-ink-strong, #ffffff);
        --link-visited-color: var(--link-hover-color);
      }

      html {
        background-color: var(--bg-color);
      }

      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        font-family: var(--font-family-serif);
        color: var(--text-color);
        transition:
          background-color 0.3s ease,
          color 0.3s ease;
      }

      html[lang="ja"],
      html[lang="ja"] body {
        --font-family-serif: "EB Garamond Variable", "Shippori Mincho",
          "Yu Mincho", "Hiragino Mincho ProN", serif;
        --font-family-sans: "Inter Variable", "Noto Sans JP", "Hiragino Sans",
          "Yu Gothic", sans-serif;
        font-family: var(--font-family-serif);
        font-feature-settings:
          "palt" 1,
          "pkna" 1;
        font-kerning: normal;
        letter-spacing: 0.015em;
        line-break: strict;
        overflow-wrap: anywhere;
        word-break: normal;
      }

      html.is-page-swapping,
      html.is-page-swapping body {
        transition: none;
      }

      .page-foreground {
        opacity: 1;
        transition: opacity 280ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      html[data-page="home"] .page-foreground {
        transition-duration: 420ms;
      }

      html.is-page-preparing .page-foreground {
        opacity: 0.42;
        transition-duration: 180ms;
        transition-timing-function: ease-out;
      }

      html.is-page-swapping .page-foreground,
      html.is-page-entering .page-foreground {
        opacity: 0;
        transition: none;
      }

      .page-wrapper {
        height: 100vh;
        height: 100dvh;
        overflow-y: auto;
        position: relative;
        overscroll-behavior-y: contain;
      }

      .main-content {
        min-height: 100vh;
        min-height: 100dvh;
        padding: 0;
      }

      @media (min-width: 768px) {
        .main-content {
          padding: 0 10vw;
        }
      }
    </style>

    <style is:global>
      .scroll-reveal-animate {
        opacity: 0;
        filter: blur(5px);
        transform: translateY(20px) translateZ(0);
        will-change: opacity, filter, transform;
        transition:
          opacity 0.8s ease-out,
          filter 0.8s ease-out,
          transform 0.8s ease-out;
      }

      .scroll-reveal-animate.visible {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0) translateZ(0);
      }

      .page-load-initial-state {
        opacity: 0;
        filter: blur(5px);
        transform: translateY(20px) translateZ(0);
        will-change: opacity, filter, transform;
      }

      @keyframes pageLoadAnimate {
        to {
          opacity: 1;
          filter: blur(0px);
          transform: translateY(0) translateZ(0);
        }
      }

      a {
        color: var(--text-color);
        text-decoration: underline;
        text-underline-offset: 0.2em;
        transition: color 0.2s ease;
      }

      a:hover,
      a:focus,
      a:active {
        color: var(--link-hover-color);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      a[href^="/"]:not([download]) {
        -webkit-tap-highlight-color: transparent;
      }

      a[href^="/"]:not([download]):active {
        transform: translateY(1px) scale(0.985);
      }

      @media (prefers-reduced-motion: reduce) {
        .scroll-reveal-animate,
        .scroll-reveal-animate.visible,
        .page-load-initial-state {
          opacity: 1;
          filter: none;
          transform: none;
          transition: none;
          animation: none;
        }
      }
    </style>

    <script>
      const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");

      const checkAndApplyTheme = () => {
        if (mediaQuery.matches) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      mediaQuery.addEventListener("change", checkAndApplyTheme);

      let pageController: AbortController | null = null;
      let pageObserver: IntersectionObserver | null = null;

      document.addEventListener("astro:before-preparation", (event) => {
        document.documentElement.classList.add("is-page-preparing");
        event.signal.addEventListener(
          "abort",
          () => document.documentElement.classList.remove("is-page-preparing"),
          { once: true }
        );
      });

      document.addEventListener("astro:before-swap", (event) => {
        document.documentElement.classList.remove("is-page-preparing");
        document.documentElement.classList.add("is-page-swapping");
        event.newDocument.documentElement.classList.add("is-page-swapping");
        event.newDocument.documentElement.classList.add("is-page-entering");
        event.newDocument.documentElement.classList.toggle(
          "dark",
          document.documentElement.classList.contains("dark")
        );
        event.newDocument.documentElement.lang =
          event.newDocument.documentElement.lang ||
          document.documentElement.lang;
        if (window.__calvinPalette) {
          event.newDocument.documentElement.dataset.palette =
            window.__calvinPalette;
        }
      });

      document.addEventListener("astro:after-swap", () => {
        requestAnimationFrame(() => {
          document.documentElement.classList.remove("is-page-swapping");
          requestAnimationFrame(() => {
            document.documentElement.classList.remove("is-page-entering");
          });
        });
      });

      function initializePage() {
        pageController?.abort();
        pageObserver?.disconnect();
        pageController = new AbortController();
        const { signal } = pageController;

        checkAndApplyTheme();
        if (window.__calvinPalette) {
          document.documentElement.dataset.palette = window.__calvinPalette;
        }

        const pageWrapper = document.querySelector(
          ".page-wrapper"
        ) as HTMLElement | null;
        if (!pageWrapper) return;

        const isHomepage =
          window.location.pathname === "/" ||
          window.location.pathname === "/index.html" ||
          window.location.pathname === "/ja" ||
          window.location.pathname === "/ja/";
        const reducedMotionQuery = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        );
        let snapPositions: number[] = [];

        const calculateSnapPositions = () => {
          if (!isHomepage) {
            snapPositions = [];
            return;
          }

          const maxScroll = Math.max(
            0,
            pageWrapper.scrollHeight - pageWrapper.clientHeight
          );
          const sections = Array.from(
            document.querySelectorAll<HTMLElement>(
              ".hero-section, .homepage-content > .section-wrapper"
            )
          );
          const centeredSections = sections.map((section) =>
            Math.min(
              maxScroll,
              Math.max(
                0,
                section.offsetTop +
                  section.offsetHeight / 2 -
                  pageWrapper.clientHeight / 2
              )
            )
          );
          snapPositions = [...centeredSections, maxScroll]
            .sort((a, b) => a - b)
            .filter(
              (position, index, positions) =>
                index === 0 || Math.abs(position - positions[index - 1]) > 2
            );
        };

        const nearestSnapIndex = () => {
          let nearestIndex = 0;
          let nearestDistance = Number.POSITIVE_INFINITY;
          snapPositions.forEach((position, index) => {
            const distance = Math.abs(pageWrapper.scrollTop - position);
            if (distance < nearestDistance) {
              nearestDistance = distance;
              nearestIndex = index;
            }
          });
          return nearestIndex;
        };

        const moveBySection = (direction: -1 | 1) => {
          calculateSnapPositions();
          if (snapPositions.length === 0) return;

          const nextIndex = Math.min(
            snapPositions.length - 1,
            Math.max(0, nearestSnapIndex() + direction)
          );
          pageWrapper.scrollTo({
            top: snapPositions[nextIndex],
            behavior: reducedMotionQuery.matches ? "auto" : "smooth",
          });
        };

        if (isHomepage) {
          calculateSnapPositions();
          window.addEventListener("resize", calculateSnapPositions, { signal });
        }

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            if (signal.aborted) return;
            pageObserver = new IntersectionObserver(
              (entries, observer) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.classList.add("visible");
                    observer.unobserve(entry.target);
                  }
                });
              },
              {
                root: pageWrapper,
                rootMargin: "0px",
                threshold: 0.2,
              }
            );

            const observeRevealTargets = () => {
              document
                .querySelectorAll(
                  ".scroll-reveal-animate:not(.visible), .project-card:not(.visible)"
                )
                .forEach((target) => pageObserver?.observe(target));
            };

            observeRevealTargets();
            document.addEventListener(
              "calvin:refresh-reveals",
              observeRevealTargets,
              { signal }
            );
          });
        });

        const indicator = document.querySelector(
          "#scroll-indicator"
        ) as HTMLElement | null;
        if (indicator) {
          const updateIndicator = () => {
            indicator.classList.toggle("visible", pageWrapper.scrollTop < 10);
          };
          const revealTimer = window.setTimeout(updateIndicator, 1400);
          signal.addEventListener("abort", () => clearTimeout(revealTimer), {
            once: true,
          });
          pageWrapper.addEventListener("scroll", updateIndicator, {
            passive: true,
            signal,
          });
          indicator.addEventListener(
            "click",
            () => {
              clearTimeout(revealTimer);
              if (isHomepage) {
                moveBySection(1);
              } else {
                pageWrapper.scrollTo({
                  top: pageWrapper.scrollTop + pageWrapper.clientHeight,
                  behavior: reducedMotionQuery.matches ? "auto" : "smooth",
                });
              }
            },
            { signal }
          );
        }

        const currentPath = window.location.pathname;
        document
          .querySelectorAll(".footer-column-2 li")
          .forEach((item) => {
            const link = item.querySelector("a");
            if (!link) return;
            const href = new URL(link.href).pathname;
            item.classList.toggle(
              "active",
              href === currentPath ||
                (href === "/" && currentPath === "/index.html")
            );
          });

        const targetId = new URLSearchParams(window.location.search).get(
          "scrollTo"
        );
        if (targetId) {
          const target = document.getElementById(targetId);
          if (target) {
            requestAnimationFrame(() => {
              pageWrapper.scrollTo({
                top: target.offsetTop,
                behavior: "smooth",
              });
              history.replaceState(null, "", window.location.pathname);
            });
          }
        } else if (!isHomepage) {
          pageWrapper.scrollTop = 0;
        }
      }

      document.addEventListener("astro:page-load", initializePage);
    </script>
  </head>
  <body>
    <div class="page-wrapper">
      <DynamicBackground />
      <div class="page-foreground">
        <main class="main-content">
          <slot />
        </main>
        <div class="some-empty-space" style="height: 20vh;"></div>
        <Footer locale={locale} currentPath={currentPath} />
        {showScrollIndicator && <ScrollIndicator locale={locale} />}
      </div>
    </div>
  </body>
</html>
