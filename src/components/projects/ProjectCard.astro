---
import { Icon } from "astro-icon/components";
import { siteContent, type Locale } from "../../i18n";

interface Props {
  id?: string;
  title: string;
  imageSrc?: string;
  imageAlt?: string;
  timeframe?: string;
  projectUrl?: string;
  githubUrl?: string;
  githubRepos?: { title?: string; url: string }[];
  techStack?: string[];
  locale: Locale;
}

const {
  id,
  title,
  imageSrc,
  imageAlt,
  timeframe,
  projectUrl,
  githubUrl,
  githubRepos,
  techStack = [],
  locale,
} = Astro.props;
const content = siteContent[locale].projects;
const resolvedImageAlt = imageAlt || content.projectThumbnail;
---

<article id={id} class="project-card">
  {
    imageSrc && (
      <div class="project-image-wrapper">
        <img
          src={imageSrc}
          alt={resolvedImageAlt}
          class="project-image"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="project-content">
    <header class="project-header">
      <h3 class="project-title">{title}</h3>
    </header>

    <div class="project-metadata">
      {timeframe && <span class="project-timeframe">{timeframe}</span>}
      {
        techStack.length > 0 && (
          <div class="project-tech-stack">
            {techStack.map((tech) => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        )
      }
      <div class="project-links">
        {
          githubRepos && githubRepos.length > 0 ? (
            githubRepos.map((repo) => (
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                title={content.repositoryTitle(repo.title || "source")}
              >
                <Icon name="ri:github-line" /> {repo.title || "GitHub"}
              </a>
            ))
          ) : githubUrl ? (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              title={content.sourceTitle}
            >
              <Icon name="ri:github-line" /> GitHub
            </a>
          ) : null
        }
        {
          projectUrl && (
            <a
              href={projectUrl}
              target="_blank"
              rel="noopener noreferrer"
              title={content.liveTitle}
            >
              <Icon name="ri:external-link-line" /> {content.liveLabel}
            </a>
          )
        }
      </div>
    </div>

    <div class="project-body">
      <slot />
    </div>
  </div>
</article>

<style>
  .project-card {
    border-radius: 8px;
    border: 1px solid var(--card-border-color);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin-bottom: 3rem;

    opacity: 0;
    transform: translateY(16px) translateZ(0);
    will-change: opacity, transform;
    transition:
      opacity 0.65s ease-out,
      transform 0.65s ease-out,
      border-color 0.2s ease;
  }

  .project-card.visible {
    opacity: 1;
    transform: translateY(0) translateZ(0);
    will-change: auto;
  }

  .project-card:hover {
    border-color: var(--card-border-hover-color);
  }

  .project-image-wrapper {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--bg-muted);
  }
  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .project-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-header {
    margin-bottom: 1rem;
  }
  .project-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: var(--heading-color);
    line-height: 1.3;
  }

  .project-metadata {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-family: var(--font-family-sans);
  }

  .project-timeframe {
    font-size: 0.9rem;
    color: var(--text-muted);
    display: block;
    font-family: inherit;
  }

  .project-tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: inherit;
    line-height: 1.4;
    padding: 0.2em 0 0;
  }

  .tech-tag {
    background-color: var(--tag-bg-color);
    color: var(--tag-text-color);
    font-size: 0.85rem;
    border-radius: 4px;
    font-family: inherit;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    align-items: center;
    font-family: inherit;
  }
  .project-links a {
    color: var(--link-color);
    text-decoration: none;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    transition: color 0.2s ease;
    font-family: inherit;
  }
  .project-links a:hover {
    color: var(--link-hover-color);
    text-decoration: underline;
  }
  .project-links :global(svg) {
    font-size: 1.2em;
  }

  .project-body {
    font-size: 1.1rem;
    line-height: 1.8;
    flex-grow: 1;
  }
  .project-body :global(p) {
    margin-bottom: 1em;
  }
  .project-body :global(ul) {
    padding-left: 1.5em;
    margin-top: 0.5em;
    list-style: disc;
  }
</style>
