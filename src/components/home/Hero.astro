---
import { getLocaleFromPath, siteContent } from "../../i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const content = siteContent[locale].home;
---

<section class="hero-section">
  <div class="hero-text">
    <div class="greeting hero-reveal">{content.greeting}</div>
    <div class="hero-name hero-reveal" lang="en">{content.name}</div>
    <div class="hero-description hero-reveal">
      {content.description}
    </div>
  </div>
</section>

<style>
  @keyframes heroReveal {
    to {
      opacity: 0.9;
      transform: translateY(0);
      will-change: auto;
    }
  }

  .hero-section {
    min-height: 100vh;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding-left: 10%;
    box-sizing: border-box;
  }

  .hero-text {
    max-width: 80%;
    transform: translateY(-5vh);
  }

  .hero-reveal {
    opacity: 0;
    transform: translateY(16px);
    will-change: opacity, transform;
    animation: heroReveal 0.7s ease-out forwards;
  }

  :global(html.is-page-entering) .hero-reveal {
    animation-play-state: paused;
  }

  .greeting {
    font-size: clamp(1.5rem, 1.5rem + 2vw, 4rem);
    color: var(--text-muted);
    margin-bottom: 10px;
    line-height: 1;
    margin-left: 10px;
  }

  .hero-name {
    font-size: clamp(3rem, 4rem + 4vw, 8rem);
    font-weight: 400;
    line-height: 1;
    animation-delay: 0.1s;
  }

  .hero-description {
    font-family: var(--font-family-serif);
    font-size: clamp(1.5rem, 1rem + 1vw, 2rem);
    font-weight: 400;
    line-height: 1.4;
    margin-top: 2em;
    margin-left: 10px;
    animation-delay: 0.2s;
  }

  :global(html[lang="ja"]) .greeting {
    font-size: clamp(1.35rem, 1.25rem + 1.3vw, 2.8rem);
    letter-spacing: 0.12em;
  }

  :global(html[lang="ja"]) .hero-description {
    max-width: 32em;
    line-height: 1.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      opacity: 0.9;
      transform: none;
      will-change: auto;
      animation: none;
    }
  }
</style>
