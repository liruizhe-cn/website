---
// Component: src/components/home/Hero.astro
---

<section class="hero-section">
  <div class="hero-text">
    <div class="greeting hero-reveal">Hello, This is</div>
    <div class="hero-name hero-reveal">Calvin Lee</div>
    <div class="hero-description hero-reveal">
      A Japanese major student at Nantong University, working across
      photography, language learning, piano, and independent app development.
    </div>
  </div>
</section>

<style>
  @keyframes heroReveal {
    to {
      filter: blur(0px);
      opacity: 0.9;
      transform: translateY(0);
    }
  }

  .hero-section {
    min-height: 100vh;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding-left: 10%;
    box-sizing: border-box;
  }

  .hero-text {
    max-width: 80%;
    transform: translateY(-5vh);
  }

  .hero-reveal {
    opacity: 0;
    filter: blur(5px);
    transform: translateY(20px);
    will-change: opacity, filter, transform;
    animation: heroReveal 0.8s ease-out forwards;
  }

  :global(html.is-page-entering) .hero-reveal {
    animation-play-state: paused;
  }

  .greeting {
    font-size: clamp(1.5rem, 1.5rem + 2vw, 4rem);
    color: var(--text-muted);
    margin-bottom: 10px;
    line-height: 1;
    margin-left: 10px;
  }

  .hero-name {
    font-size: clamp(3rem, 4rem + 4vw, 8rem);
    font-weight: 400;
    line-height: 1;
    animation-delay: 0.1s;
  }

  .hero-description {
    font-family: var(--font-family-serif);
    font-size: clamp(1.5rem, 1rem + 1vw, 2rem);
    font-weight: 400;
    line-height: 1.4;
    margin-top: 2em;
    margin-left: 10px;
    animation-delay: 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      opacity: 0.9;
      filter: none;
      transform: none;
      animation: none;
    }
  }
</style>
