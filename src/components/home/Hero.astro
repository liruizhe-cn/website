---
// Component: src/components/home/Hero.astro
---

<section class="hero-section">
  <div class="hero-text">
    <div class="greeting">Hello, This is</div>
    <div class="hero-name">Calvin Lee</div>
    <div class="hero-description">
      A Japanese major student at Nantong University, working across
      photography, language learning, piano, and independent app development.
    </div>
  </div>
</section>

<style>
  @keyframes unblurFadeIn {
    0% {
      filter: blur(2px);
      opacity: 0.72;
      transform: translateY(4px);
    }
    100% {
      filter: blur(0px);
      opacity: 0.9;
      transform: translateY(0);
    }
  }

  .hero-section {
    min-height: 100vh;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding-left: 10%;
    box-sizing: border-box;
  }

  .hero-text {
    max-width: 80%;
    transform: translateY(-5vh);
  }

  .greeting {
    font-size: clamp(1.5rem, 1.5rem + 2vw, 4rem);
    color: var(--text-muted);
    margin-bottom: 10px;
    line-height: 1;
    opacity: 0.72;
    margin-left: 10px;
    animation: unblurFadeIn 0.46s ease-out forwards;
  }

  .hero-name {
    font-size: clamp(3rem, 4rem + 4vw, 8rem);
    font-weight: 400;
    line-height: 1;
    opacity: 0.72;
    animation: unblurFadeIn 0.5s ease-out 0.05s forwards;
  }

  .hero-description {
    font-family: var(--font-family-serif);
    font-size: clamp(1.5rem, 1rem + 1vw, 2rem);
    font-weight: 400;
    line-height: 1.4;
    margin-top: 2em;
    margin-left: 10px;
    opacity: 0.72;
    animation: unblurFadeIn 0.52s ease-out 0.1s forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .greeting,
    .hero-name,
    .hero-description {
      opacity: 0.9;
      animation: none;
    }
  }
</style>
