---
import Button from "../../common/Button.astro";
import { Icon } from "astro-icon/components";
import {
  getLocaleFromPath,
  localizedPath,
  siteContent,
} from "../../../i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const content = siteContent[locale];
const contactUrl = localizedPath(locale, "/contact");
---

<h2 slot="title" class="about-title scroll-reveal-animate">{content.home.connectTitle}</h2>

<div class="about-content scroll-reveal-animate">
  {content.home.connectParagraphs.map((paragraph) => <p>{paragraph}</p>)}

  <div class="connect-icon-links">
    <a
      href="mailto:clium@yahoo.com"
      title={content.accessibility.email}
      aria-label={content.accessibility.email}
    >
      <Icon name="ri:mail-line" size={24} aria-hidden="true" />
    </a>
    <a
      href="https://github.com/liruizhe-cn"
      target="_blank"
      rel="noopener noreferrer"
      title={content.accessibility.github}
      aria-label={content.accessibility.github}
    >
      <Icon name="ri:github-line" size={22} aria-hidden="true" />
    </a>
  </div>

  <div class="button-group">
    <Button
      class="button"
      href={contactUrl}
      text={content.home.contactCta}
      wrapperClass="cta-link"
    />
  </div>
</div>

<style>
  p {
    margin-bottom: 1.5rem;
    line-height: 1.7;
    color: var(--theme-text);
  }

  .connect-icon-links {
    display: flex;
    align-items: center;
    gap: 1.8rem;
    margin-bottom: 2.5rem;
  }

  .connect-icon-links a {
    color: var(--theme-icon-color);
    opacity: 0.8;
    transition:
      opacity 0.2s ease,
      color 0.2s ease;
    display: inline-block;
  }

  .connect-icon-links a:hover,
  .connect-icon-links a:focus {
    opacity: 1;
    outline: none;
  }

  .button-group {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
