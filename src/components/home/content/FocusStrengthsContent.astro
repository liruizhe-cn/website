---
import { getLocaleFromPath, siteContent } from "../../../i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const content = siteContent[locale].home;
const focusAreas = content.focusAreas;
---

<h2 slot="title" class="about-title scroll-reveal-animate">
  {content.focusTitle}
</h2>

<div class="about-content focus-grid">
  {
    focusAreas.map((area) => (
      <article class="focus-item scroll-reveal-animate">
        <h3>{area.title}</h3>
        <p>{area.description}</p>
      </article>
    ))
  }
</div>

<style>
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2.5rem;
    max-width: 78ch;
  }

  .focus-item {
    padding-top: 1.25rem;
    border-top: 1px solid var(--button-border-color);
  }

  .focus-item h3 {
    margin: 0 0 0.65rem;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .focus-item p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  @media (max-width: 767px) {
    .focus-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
