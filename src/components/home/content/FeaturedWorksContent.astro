---
import type { ProjectDataItem } from "../../../data/projectsData";
import FeaturedProjectCard from "../FeaturedProjectCard.astro"; // Import the new card component
import Button from "../../common/Button.astro";
import {
  getLocaleFromPath,
  getProjects,
  localizedPath,
  siteContent,
} from "../../../i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const content = siteContent[locale].home;
const featuredProjects: ProjectDataItem[] = getProjects(locale).filter(
  (project) => project.isFeatured
);
const projectsUrl = localizedPath(locale, "/projects");

function slugify(text: string): string {
  return text
    .toString()
    .toLowerCase()
    .replace(/\s+/g, "-") // Replace spaces with -
    .replace(/[^\w-]+/g, "") // Remove all non-word chars (removed \ before -)
    .replace(/--+/g, "-") // Replace multiple - with single - (removed \ before -)
    .replace(/^-+/, "") // Trim - from start of text
    .replace(/-+$/, ""); // Trim - from end of text
}
---

<h2
  slot="title"
  class="about-title scroll-target-title scroll-reveal-animate"
>
  {content.featuredTitle}
</h2>

<div
  class="about-content scroll-target-content scroll-reveal-animate featured-works-container"
>
  {
    featuredProjects.map((project) => {
      const slug = slugify(project.title);
      return (
        <FeaturedProjectCard
          title={project.title}
          homepageSummary={project.homepageSummary}
          imageAlt={project.imageAlt}
          githubUrl={project.githubUrl}
          slug={slug}
          locale={locale}
        />
      );
    })
  }

  <div class="button-group">
    <Button
      class="button"
      href={projectsUrl}
      text={content.featuredCta}
      wrapperClass="projects-cta-button"
    />
  </div>
</div>

<style>
  .featured-works-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 696px) {
    .featured-works-container {
      width: 100%;
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .button-group {
    display: flex;
    gap: 1rem;
  }
</style>
