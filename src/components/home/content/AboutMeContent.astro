---
// Content for the "Meet me!" section
import Button from "../../common/Button.astro";
import {
  getLocaleFromPath,
  localizedPath,
  siteContent,
} from "../../../i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const content = siteContent[locale].home;
const resumeUrl = localizedPath(locale, "/resume");
// const contactUrl = "/contact";
---

<h2 slot="title" class="about-title scroll-reveal-animate">{content.aboutTitle}</h2>

<div class="about-content scroll-reveal-animate">
  {content.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}

  <div class="button-group">
    <Button
      class="button"
      href={resumeUrl}
      text={content.resumeCta}
      wrapperClass="meet-me-cta-button"
    />
  </div>
</div>

<style>
  .button-group {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
