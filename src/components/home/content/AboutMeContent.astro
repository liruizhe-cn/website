---
// Content for the "Meet me!" section
import Button from "../../common/Button.astro";

const resumeUrl = "/resume";
// const contactUrl = "/contact";
---

<h2 slot="title" class="about-title scroll-reveal-animate">About me</h2>

<div class="about-content scroll-reveal-animate">
  <p>
    I often begin with everyday observations: a missed photo, a sentence in
    another language, a small friction in daily life, or a tool I wish existed.
  </p>

  <p>
    I turn these observations into visual records, written notes, and small
    digital products. Photography, language, music, and app design are
    different ways for me to notice more carefully and make ideas tangible.
  </p>

  <div class="button-group">
    <Button
      class="button"
      href={resumeUrl}
      text="View My Résumé"
      wrapperClass="meet-me-cta-button"
    />
  </div>
</div>

<style>
  .button-group {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
