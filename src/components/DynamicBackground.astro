  #dynamic-background-container {
    position: fixed;
    inset: -10vmax;
    z-index: -1;
    overflow: hidden;
    opacity: 0;
    contain: strict;
    pointer-events: none;
    transform: translateZ(0) scale(1.025);
    background: var(--aurora-surface);
    transition:
      opacity 1.05s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.05s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #dynamic-background-container.is-ready {
    opacity: var(--dynamic-bg-opacity);
    transform: translateZ(0) scale(1);
  }

  .aurora-field,
  .aurora {
    position: absolute;
    will-change: transform;
    transform: translateZ(0);
  }

  .aurora-field {
    inset: -18%;
    background:
      radial-gradient(circle at 48% 38%, var(--aurora-secondary), transparent 46%),
      radial-gradient(circle at 58% 68%, var(--aurora-primary), transparent 48%),
      conic-gradient(
        from 25deg at 50% 50%,
        color-mix(in oklch, var(--aurora-primary) 76%, transparent),
        color-mix(in oklch, var(--aurora-secondary) 82%, transparent),
        color-mix(in oklch, var(--aurora-secondary) 70%, var(--aurora-surface)),
        color-mix(in oklch, var(--aurora-accent) 38%, transparent),
        color-mix(in oklch, var(--aurora-primary) 76%, transparent)
      );
    filter: blur(10vmax);
    opacity: 0.64;
    animation: field-flow 18s ease-in-out infinite alternate;
  }

  .aurora {
    width: 64vmax;
    height: 52vmax;
    border-radius: 44% 56% 62% 38%;
    filter: blur(8vmax) saturate(118%);
    opacity: 0.66;
    mix-blend-mode: screen;
  }

  .aurora-mint {
    top: -8%;
    left: -4%;
    background: radial-gradient(
      ellipse at center,
      var(--aurora-primary) 0%,
      color-mix(in oklch, var(--aurora-primary) 66%, var(--aurora-surface)) 46%,
      transparent 73%
    );
    animation: drift-mint 16s ease-in-out infinite alternate;
  }

  .aurora-violet {
    top: -2%;
    right: -8%;
    background: radial-gradient(
      ellipse at center,
      var(--aurora-secondary) 0%,
      color-mix(in oklch, var(--aurora-secondary) 66%, var(--aurora-surface)) 48%,
      transparent 74%
    );
    animation: drift-violet 19s ease-in-out infinite alternate;
  }

  .aurora-gold {
    right: 8%;
    bottom: -12%;
    width: 48vmax;
    height: 42vmax;
    background: radial-gradient(
      ellipse at center,
      var(--aurora-accent) 0%,
      color-mix(in oklch, var(--aurora-accent) 54%, transparent) 42%,
      transparent 72%
    );
    opacity: 0.34;
    animation: drift-gold 22s ease-in-out infinite alternate;
  }

  @keyframes field-flow {
    from {
      transform: translate3d(-4%, -3%, 0) rotate(-5deg) scale(1);
    }
    to {
      transform: translate3d(5%, 4%, 0) rotate(7deg) scale(1.16);
    }
  }

  @keyframes drift-mint {
    from {
      transform: translate3d(-12%, -8%, 0) rotate(-8deg) scale(0.92);
    }
    to {
      transform: translate3d(24%, 18%, 0) rotate(14deg) scale(1.14);
    }
  }

  @keyframes drift-violet {
    from {
      transform: translate3d(14%, -10%, 0) rotate(12deg) scale(1.08);
    }
    to {
      transform: translate3d(-24%, 20%, 0) rotate(-14deg) scale(0.9);
    }
  }

  @keyframes drift-gold {
    from {
      transform: translate3d(12%, 18%, 0) rotate(-10deg) scale(0.9);
    }
    to {
      transform: translate3d(-22%, -22%, 0) rotate(12deg) scale(1.12);
    }
  }

  @media (max-width: 767px) {
    #dynamic-background-container {
      inset: -18vmax;
    }

    .aurora {
      width: 76vmax;
      height: 62vmax;
      filter: blur(11vmax) saturate(114%);
      opacity: 0.64;
      animation-duration: 26s;
    }

    .aurora-field {
      inset: -26%;
      filter: blur(13vmax) saturate(112%);
      animation-duration: 22s;
    }

    .aurora-gold {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #dynamic-background-container {
      transform: translateZ(0);
      transition-duration: 180ms;
    }

    .aurora-field,
    .aurora {
      animation: none;
    }

    .aurora-field {
      transform: scale(1.08);
    }

    .aurora-mint {
      transform: translate3d(2%, 2%, 0) scale(1);
    }

    .aurora-violet {
      transform: translate3d(-4%, 4%, 0) scale(1);
    }

    .aurora-gold {
      transform: translate3d(-2%, -4%, 0) scale(1);
    }
  }
</style>

<script>
  const background = document.querySelector(
    "#dynamic-background-container"
  ) as HTMLElement | null;

  if (background && !background.classList.contains("is-ready")) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => background.classList.add("is-ready"));
    });
  }
</script>
