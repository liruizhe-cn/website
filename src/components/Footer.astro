---
import {
  localizedPath,
  siteContent,
  type Locale,
} from "../i18n";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const content = siteContent[locale].footer;
const currentYear = new Date().getFullYear();
const englishPath = localizedPath("en", currentPath);
const japanesePath = localizedPath("ja", currentPath);
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-column footer-column-1">
      <h4>{content.about}</h4>
      <a href="https://icp.gov.moe/?keyword=20220698" target="_blank">MOE ICP No.20220698</a>
      <p class="footer-description">
        {content.builtBy}
      </p>
      <p class="copyright">&copy; {currentYear} CalvinLee. {content.copyright}</p>
    </div>
    <div class="footer-column footer-column-2">
      <h4>{content.links}</h4>
      <ul>
        <li><a href={localizedPath(locale, "/")} data-astro-prefetch>{content.home}</a></li>
        <li><a href={localizedPath(locale, "/resume")} data-astro-prefetch>{content.resume}</a></li>
        <li><a href={localizedPath(locale, "/contact")} data-astro-prefetch>{content.contact}</a></li>
      </ul>
    </div>
    <div class="footer-column footer-column-3">
      <h4>{content.connect}</h4>
      <ul>
        <li>
          <a
            class="link"
            href={localizedPath(locale, "/contact")}>WeChat</a
          >
        </li>
        <li>
          <a
            class="link"
            href="mailto:clium@yahoo.com"
            target="_blank"
            rel="noopener noreferrer">Email</a
          >
        </li>
      </ul>
    </div>
    <div class="footer-column footer-column-4">
      <h4>{content.language}</h4>
      <ul class="language-list" aria-label={content.languageLabel}>
        <li>
          {
            locale === "en" ? (
              <span aria-current="true">English</span>
            ) : (
              <a href={englishPath} data-language="en">English</a>
            )
          }
        </li>
        <li>
          {
            locale === "ja" ? (
              <span aria-current="true">日本語</span>
            ) : (
              <a href={japanesePath} data-language="ja">日本語</a>
            )
          }
        </li>
      </ul>
    </div>
  </div>
</footer>

<script>
  function initializeLanguageLinks() {
    document.querySelectorAll<HTMLAnchorElement>("[data-language]").forEach((link) => {
      link.addEventListener("click", () => {
        try {
          window.localStorage.setItem(
            "calvin-site-language",
            link.dataset.language || "en"
          );
        } catch {}
      });
    });
  }

  document.addEventListener("astro:page-load", initializeLanguageLinks);
</script>

<style>
  .site-footer {
    background-color: var(--footer-bg);
    color: var(--footer-text);
    padding: 4rem 10%;
    min-height: 40vh;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 5;
    font-family: var(--font-family-sans);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
    animation: footer-fade-in 0.45s ease-out both;
  }

  @keyframes footer-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer {
      animation: none;
    }
  }

  .footer-content {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    width: 100%;
  }

  .footer-column {
    margin-bottom: 1.5rem;
  }

  .footer-column-1 {
    flex-basis: 100%;
  }
  .footer-column-2,
  .footer-column-3,
  .footer-column-4 {
    flex: 1;
  }

  .footer-column h4 {
    color: var(--footer-heading);
    margin-bottom: 1em;
    font-weight: 600;
  }

  .footer-column p,
  .footer-column ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-column ul li {
    margin-bottom: 0.5em;
  }

  .footer-column a {
    color: var(--footer-link);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-column a:hover,
  .footer-column a:focus {
    color: var(--footer-link-hover);
    text-decoration: underline;
  }

  .language-list span[aria-current="true"] {
    color: var(--footer-heading);
    font-weight: 600;
  }

  .footer-column p.copyright {
    margin-top: 2em;
    font-size: 0.8rem;
    color: var(--footer-copyright);
  }

  .footer-column-2 ul li.active {
    display: none;
  }

  @media (min-width: 768px) {
    .site-footer {
      padding: 4rem 20%;
    }
    .footer-content {
      flex-wrap: nowrap;
      gap: 3rem;
    }
    .footer-column {
      margin-bottom: 0;
    }
    .footer-column-1 {
      flex: 4 1 0%;
    }
    .footer-column-2,
    .footer-column-3,
    .footer-column-4 {
      flex: 1 1 0%;
    }

    .footer-description {
      width: 75%;
    }
  }
</style>
