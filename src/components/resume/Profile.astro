---
// src/components/resume/Profile.astro
---

<section class="resume-section scroll-reveal-animate">
  <h2>Profile</h2>
  <p>
    A Japanese major student at Nantong University, interested in photography,
    piano, language learning, and independent app development.
  </p>
  <p>
    I enjoy turning personal observations into small digital products. My
    current work focuses on creative tools, everyday productivity, and personal
    reflection through app design.
  </p>
</section>

<style>
  .resume-section {
    margin-bottom: 4rem;
  }
  h2 {
    font-size: clamp(1.8rem, 1.5rem + 1.5vw, 2.8rem);
    margin-bottom: 2rem;
    font-weight: 600;
    border-bottom: 1px solid var(--text-muted);
    padding-bottom: 0.5rem;
  }
  p {
    line-height: 1.6;
    font-size: 1.1rem;
  }
</style>
