---
// No props needed
---

<section class="resume-section scroll-reveal-animate">
  <h2>App Projects</h2>

  <div class="project-entry">
    <div class="header">
      <span class="institution"><strong>Echo</strong></span>
    </div>
    <p class="description">
      A lightweight productivity app focused on helping users restart tasks
      through quick capture, short attempts, and gentle reflection. It explores
      how a small app can reduce the friction between intention and action.
    </p>
  </div>

  <div class="project-entry">
    <div class="header">
      <span class="institution"><strong>Kisp</strong></span>
    </div>
    <p class="description">
      A personal app project currently in development. It focuses on turning
      small everyday needs into a simple, usable mobile experience.
    </p>
  </div>

  <div class="project-entry">
    <div class="header">
      <span class="institution"><strong>Lanent</strong></span>
    </div>
    <p class="description">
      A photography-oriented app for recording unfinished visual ideas, missed
      shots, and future shooting clues. It is designed as a personal map of
      photographic regrets, inspirations, and recurring visual patterns.
    </p>
  </div>
</section>

<style>
  .resume-section {
    margin-bottom: 4rem;
  }
  h2 {
    font-size: clamp(1.8rem, 1.5rem + 1.5vw, 2.8rem);
    margin-bottom: 2rem;
    font-weight: 600;
    border-bottom: 1px solid var(--text-muted);
    padding-bottom: 0.5rem;
  }
  .project-entry {
    margin-bottom: 2.5rem;
  }
  .project-entry:last-child {
    margin-bottom: 0;
  }
  .project-entry .header {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-bottom: 0.8rem;
    font-size: 1.2rem;
    align-items: baseline;
  }
  .project-entry .description {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.6;
  }
  @media (max-width: 600px) {
    .project-entry .header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
